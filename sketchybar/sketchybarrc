#!/usr/bin/env bash
CONFIG_DIR="$HOME/.config/sketchybar"
PLUGIN_DIR="$CONFIG_DIR/plugins"
source "$CONFIG_DIR/style.sh"

FONT="GeistMono Nerd Font"

# bar
bar=(
height=$HEIGHT
position=top
color=0x00000000
padding_left=0
padding_right=0
corner_radius=0
border_width=0
y_offset=6
margin=6
sticky=on
)
sketchybar --bar "${bar[@]}"

# defaults
default=(
icon.font="$FONT:Regular:14.0"
icon.color=$FG
label.font="$FONT:Regular:13.0"
label.color=$FG
padding_left=1
padding_right=1
icon.padding_left=8
icon.padding_right=1
label.padding_left=4
label.padding_right=8
background.corner_radius=16
background.height=24
background.drawing=off
)
sketchybar --default "${default[@]}"

# spaces (driven by yabai signal space_focus)
sketchybar --add event yabai_spaces_change
sketchybar --add event yabai_windows_change

# hidden driver: reconciles space items from yabai on every relevant change
sketchybar --add item spaces_driver left \
--set spaces_driver drawing=off updates=on script="$PLUGIN_DIR/spaces.sh" \
--subscribe spaces_driver yabai_spaces_change yabai_windows_change

# right cluster: data block, mirrors the spaces bracket
datetime=(
icon.drawing=off
label.padding_left=8
update_freq=10
script="$PLUGIN_DIR/datetime.sh"
click_script="open -a Calendar"
padding_right=4
)
sketchybar --add item datetime right \
--set datetime "${datetime[@]}" \
--subscribe datetime mouse.entered mouse.exited

battery=(
update_freq=120
script="$PLUGIN_DIR/battery.sh"
# no Control Center popover: the battery module is not pinned to the menu bar
click_script="open 'x-apple.systempreferences:com.apple.Battery-Settings.extension'"
)
sketchybar --add item battery right \
--set battery "${battery[@]}" \
--subscribe battery power_source_change mouse.entered mouse.exited

volume=(
update_freq=10
icon.padding_right=8
script="$PLUGIN_DIR/volume.sh"
click_script="$PLUGIN_DIR/volume_popup.sh"
popup.align=right
popup.y_offset=2
popup.height=26
popup.background.color=$BASE
popup.background.corner_radius=12
popup.background.border_color=$BG
popup.background.border_width=2
)
sketchybar --add item volume right \
--set volume "${volume[@]}" \
--subscribe volume volume_change mouse.entered mouse.exited mouse.exited.global

wifi=(
update_freq=10
icon.padding_right=8
script="$PLUGIN_DIR/wifi.sh"
click_script="open 'x-apple.systempreferences:com.apple.wifi-settings-extension'"
padding_left=4
)
sketchybar --add item wifi right \
--set wifi "${wifi[@]}" \
--subscribe wifi mouse.entered mouse.exited

media=(
update_freq=1
icon.padding_right=8
label.width=220
label.align=left
script="$PLUGIN_DIR/media.sh"
click_script="$PLUGIN_DIR/media.sh click"
drawing=off
padding_left=4
)
sketchybar --add item media right \
--set media "${media[@]}" \
--subscribe media mouse.entered mouse.exited

sketchybar --add bracket data media datetime battery volume wifi \
--set data "${bracket[@]}"

# initial render
"$PLUGIN_DIR/spaces.sh"

sketchybar --update
