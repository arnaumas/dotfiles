# set ft=sh

yabai -m signal --add event=dock_did_restart action="sudo yabai --load-sa; yabai -m config window_shadow float"
sudo yabai --load-sa

yabai -m config layout bsp
yabai -m config split_type vertical
yabai -m config window_placement second_child
yabai -m config split_ratio 0.5
yabai -m config auto_balance off

yabai -m config top_padding    8
yabai -m config bottom_padding 8
yabai -m config left_padding   8
yabai -m config right_padding  8
yabai -m config window_gap     10

yabai -m config window_shadow float

yabai -m config external_bar all:32:0

# yabai -m config mouse_follows_focus on
yabai -m config mouse_modifier       ctrl
yabai -m config mouse_action1        move
yabai -m config mouse_action2        resize
yabai -m config mouse_drop_action    swap

yabai -m rule --add app="^Configuració del Sistema$" manage=off
yabai -m rule --add app="^Finder$" manage=off
yabai -m rule --add app="^Calculator$" manage=off
yabai -m rule --add app="^Karabiner-Elements$" manage=off
yabai -m rule --add app="^Karabiner-EventViewer$" manage=off
yabai -m rule --add app="^QuickTime Player$" manage=off
yabai -m rule --add app="^Monitor d'Activitat$" manage=off
yabai -m rule --add app="^Logi Options\+$" manage=off
yabai -m rule --add app="^Monitor" manage=off
yabai -m rule --add app="^Raycast Beta$" manage=off

# scratchpads: floating, parked off-screen, summoned onto the current space.
# toggled from skhd via ~/.config/yabai/scratchpad.sh <label>.
# the ghostty rule is title-scoped so it only catches the scratchpad window.
yabai -m rule --add app="^Ghostty$" title="^scratchpad$" scratchpad=ghostty
yabai -m rule --add app="WhatsApp"                       scratchpad=whatsapp
yabai -m rule --add app="^Música$"                       scratchpad=music
yabai -m signal --add event=window_title_changed app="^JabRef$" action='
  title="$(yabai -m query --windows --window $YABAI_WINDOW_ID | jq -r .title)"
  [ "$title" = "New entry" ] && yabai -m window $YABAI_WINDOW_ID --toggle float
'

# float child window
yabai -m signal --add event=window_created action='
  yabai -m query --windows --window $yabai_window_id | jq -er ".\"can-resize\" or .\"is-floating\"" || \
  yabai -m window $yabai_window_id --toggle float --layer above --grid 4:4:1:1:2:2
'

PADDING="$HOME/.config/yabai/padding.sh"
for ev in window_created window_destroyed space_created space_changed display_changed; do
	yabai -m signal --add event=$ev action="$PADDING"
done
"$PADDING"

# sketchybar mirrors yabai's spaces/windows
yabai -m signal --add event=space_changed              action="sketchybar --trigger yabai_spaces_change"
yabai -m signal --add event=display_changed            action="sketchybar --trigger yabai_spaces_change"
yabai -m signal --add event=space_created              action="sketchybar --trigger yabai_spaces_change"
yabai -m signal --add event=space_destroyed            action="sketchybar --trigger yabai_spaces_change"
yabai -m signal --add event=window_created             action="sketchybar --trigger yabai_windows_change"
yabai -m signal --add event=window_destroyed           action="sketchybar --trigger yabai_windows_change"
yabai -m signal --add event=application_front_switched action="sketchybar --trigger yabai_windows_change"

borders &
